@page "/chat"
@implements IDisposable
@using System.Text.Json.Nodes
@inject DemoApiClient Api
@inject DemoState Demo

<PageTitle>Agent chat — NICEDA</PageTitle>
<h1>Agent chat</h1>
<p>Ask the same question in Before and After. Answers, citations and tool outcomes come from the API, not the UI.</p>
@if (Demo.Mode == "before")
{
    <p class="text-secondary">Before mode does not provide <code>get_customer_health</code>; use support knowledge to compare retrieval. The optimized health projection is available only in After mode.</p>
}
<p class="text-secondary"><strong>Admin example:</strong> Contoso is outside Jane's account scope. Select the admin demo identity to try Contoso.</p>
<div class="sample-questions" role="group" aria-label="Sample questions">
    @foreach (var question in Questions)
    {
        <button class="btn btn-outline-secondary" disabled="@Demo.IsBusy" @onclick="() => _message = question">@question</button>
    }
</div>
<form @onsubmit="SendAsync" @onsubmit:preventDefault>
    <label for="chat-message" class="form-label">Your question</label>
    <textarea id="chat-message" class="form-control" rows="3" @bind="_message" disabled="@Demo.IsBusy"></textarea>
    <button class="btn btn-primary mt-2" type="submit" disabled="@(Demo.IsBusy || string.IsNullOrWhiteSpace(_message))">
        @(_sending ? "Asking agent…" : "Ask agent")
    </button>
</form>
@if (_error is not null)
{
    <div class="alert alert-danger mt-3" role="alert"><strong>Request failed.</strong> @_error</div>
}
@if (_sending) { <p class="mt-3" role="status">Waiting for the agent and its tools…</p> }
@if (_response is not null)
{
    <section class="record-card mt-3" aria-label="Agent result">
        <h2>Answer</h2>
        <p class="text-secondary">@_requestMode · @_requestUser · @_askedMessage</p>
        <MarkdownAnswer Text='@Display(_response["answer"])' />
        <h3>Citations</h3>
        <JsonResult Value='_response["citations"]' />
        <h3>Tool calls</h3>
        <JsonResult Value='_response["toolCalls"]' />
        <h3>Action outcomes</h3>
        <JsonResult Value='_response["actionOutcomes"]' />
        @if (!string.IsNullOrWhiteSpace(_response["feedbackWarning"]?.ToString()))
        {
            <div class="alert alert-warning mt-2" role="alert">@_response["feedbackWarning"]</div>
        }
        <details><summary>Full API response</summary><pre>@_response.ToJsonString(JsonOptions)</pre></details>
    </section>
    @if (!string.IsNullOrWhiteSpace(_interactionId))
    {
        <section class="record-card mt-3" aria-label="Answer feedback">
            <h2>Was this useful?</h2>
            <label for="feedback-comment">Comment (optional)</label>
            <textarea id="feedback-comment" class="form-control mb-2" @bind="_comment" disabled="@(Demo.IsBusy || _feedbackSent)"></textarea>
            <button class="btn btn-outline-success" disabled="@(Demo.IsBusy || _feedbackSent)" @onclick="() => FeedbackAsync(1)">Helpful</button>
            <button class="btn btn-outline-danger" disabled="@(Demo.IsBusy || _feedbackSent)" @onclick="() => FeedbackAsync(-1)">Not helpful</button>
            @if (_feedbackBusy) { <p role="status">Saving feedback…</p> }
            @if (_feedbackSent) { <p role="status">Feedback saved by the API.</p> }
            @if (_feedbackError is not null) { <div class="alert alert-danger mt-2" role="alert">Feedback failed: @_feedbackError</div> }
        </section>
    }
}

@code {
    private static readonly string[] Questions =
    [
        "Which customers are at risk of renewal, and why?",
        "Summarize Techorama's data export incident with sources.",
        $"Create one follow-up task for Techorama. Reason: Review data export reliability before the next event. Due date: {DateTime.UtcNow.AddDays(14):yyyy-MM-dd}."
    ];
    private static readonly System.Text.Json.JsonSerializerOptions JsonOptions = new() { WriteIndented = true };
    private readonly CancellationTokenSource _lifetime = new();
    private string _message = Questions[0];
    private string _askedMessage = "";
    private string _requestMode = "";
    private string _requestUser = "";
    private string? _pendingRequestKey;
    private string? _pendingRequestContext;
    private string? _interactionId;
    private string _comment = "";
    private string? _error;
    private string? _feedbackError;
    private bool _sending;
    private bool _feedbackBusy;
    private bool _feedbackSent;
    private JsonObject? _response;

    protected override void OnInitialized() => Demo.Changed += OnChanged;
    private void OnChanged() => _ = InvokeAsync(() =>
    {
        if (_requestMode != Demo.Mode || _requestUser != Demo.UserId)
        {
            _response = null;
            _interactionId = null;
            _error = null;
            _feedbackError = null;
            _pendingRequestContext = null;
            _pendingRequestKey = null;
        }
        StateHasChanged();
    });

    private async Task SendAsync()
    {
        if (Demo.IsBusy || string.IsNullOrWhiteSpace(_message)) return;
        _sending = true;
        _error = null;
        _response = null;
        _interactionId = null;
        _feedbackSent = false;
        _feedbackError = null;
        _comment = "";
        _requestMode = Demo.Mode;
        _requestUser = Demo.UserId;
        _askedMessage = _message.Trim();
        var requestContext = $"{_requestMode}\n{_requestUser}\n{_askedMessage}";
        if (!string.Equals(_pendingRequestContext, requestContext, StringComparison.Ordinal))
        {
            _pendingRequestContext = requestContext;
            _pendingRequestKey = Guid.NewGuid().ToString("N");
        }
        using var operation = Demo.BeginOperation();
        try
        {
            var response = await Api.ChatAsync(_askedMessage, _requestMode, _requestUser, _pendingRequestKey!, _lifetime.Token);
            if (response["answer"] is null || string.IsNullOrWhiteSpace(Display(response["answer"])))
                throw new InvalidOperationException("The chat API response did not include an answer. No result is being shown.");
            _response = response;
            _interactionId = response["interactionId"]?.ToString();
            if (string.IsNullOrWhiteSpace(response["feedbackWarning"]?.ToString()))
            {
                _pendingRequestContext = null;
                _pendingRequestKey = null;
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Polly.Timeout.TimeoutRejectedException)
        {
            _error = "The agent exceeded the five-minute request timeout. Retry the same question to reuse its pending operation key.";
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException or InvalidOperationException or OperationCanceledException)
        {
            _error = exception.Message;
        }
        finally { _sending = false; }
    }

    private async Task FeedbackAsync(int rating)
    {
        if (Demo.IsBusy || _feedbackSent || string.IsNullOrWhiteSpace(_interactionId)) return;
        _feedbackBusy = true;
        _feedbackError = null;
        using var operation = Demo.BeginOperation();
        try
        {
            await Api.FeedbackAsync(_interactionId, _requestUser, rating, _comment, _lifetime.Token);
            _feedbackSent = true;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException or InvalidOperationException or OperationCanceledException or Polly.Timeout.TimeoutRejectedException)
        {
            _feedbackError = exception.Message;
        }
        finally { _feedbackBusy = false; }
    }

    private static string Display(JsonNode? node) => node is JsonValue value && value.TryGetValue<string>(out var text)
        ? text : node?.ToJsonString(JsonOptions) ?? "";

    public void Dispose()
    {
        Demo.Changed -= OnChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
