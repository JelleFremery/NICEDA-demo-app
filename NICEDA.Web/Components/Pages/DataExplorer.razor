@page "/data-explorer"
@implements IDisposable
@using System.Text.Json.Nodes
@inject DataExplorerApiClient Api
@inject DemoState Demo

<PageTitle>Data explorer — NICEDA</PageTitle>
<h1>Data explorer</h1>
<p>@(Demo.Mode == "before" ? "Before: human-friendly fields, raw joins and inconsistent documents." : "After: business concepts, customer health and classified knowledge.")</p>
<div class="system-tabs" role="group" aria-label="Source system">
    @foreach (var system in Systems)
    {
        <button class="btn @(_selected == system ? "btn-primary" : "btn-outline-primary")"
                disabled="@Demo.IsBusy" aria-pressed="@(_selected == system)"
                @onclick="() => SelectAsync(system)">@system</button>
    }
    <button class="btn btn-outline-secondary" disabled="@Demo.IsBusy"
            @onclick="() => SelectAsync(_selected)">Refresh</button>
</div>
@if (_error is not null)
{
    <div class="alert alert-danger" role="alert"><strong>Could not load @_selected.</strong> @_error</div>
}
@if (_loading)
{
    <p role="status">Loading @_selected…</p>
}
else if (_error is null && _rows.Count == 0)
{
    <p>No records returned by the API.</p>
}
else if (_error is null)
{
    <p class="text-secondary">@_rows.Count records · @_selected · @(IsModeIndependent ? "both modes" : _loadedMode)</p>
    @if (_loadedMode == "before" || IsModeIndependent)
    {
        <div class="raw-table" tabindex="0" role="region" aria-label="Raw fields (scroll horizontally)">
            <table class="table table-striped">
                <thead><tr>@foreach (var column in _columns) { <th scope="col">@column</th> }</tr></thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr class="@RowClass(row)">
                            @foreach (var column in _columns)
                            {
                                var value = Display(row[column]);
                                if (column.Equals("salesNotes", StringComparison.OrdinalIgnoreCase))
                                {
                                    <td class="long-text-cell">
                                        <span class="truncated-cell-text" title="@value" aria-label="@value" tabindex="0">@value</span>
                                    </td>
                                }
                                else
                                {
                                    <td class="@(IsEmailAddress(value) ? "email-cell" : null)">@value</td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="record-cards">
            @foreach (var row in _rows)
            {
                <article class="record-card">
                    <h2>@Title(row)</h2>
                    <dl>@foreach (var field in row) { <dt>@field.Key</dt><dd>@Display(field.Value)</dd> }</dl>
                    <details><summary>API JSON</summary><pre>@Json(row)</pre></details>
                </article>
            }
        </div>
    }
    @if (_loadedMode == "before" || IsModeIndependent)
    {
        <details class="mt-3"><summary>Raw API JSON</summary><pre>@Json(_rows)</pre></details>
    }
}

@code {
    private static readonly string[] Systems = ["CRM", "SQL", "Cosmos DB", "SharePoint", AuditLog, AgentUsage];
    private const string AuditLog = "Audit log";
    // NICEDA-PRACTICE-10: which customers/capabilities the agent never touches.
    private const string AgentUsage = "Agent usage";
    private bool IsModeIndependent => _selected is AuditLog or AgentUsage;
    private readonly CancellationTokenSource _lifetime = new();
    private string _selected = Systems[0];
    private string _loadedMode = "";
    private string _loadedUserId = "";
    private bool _loading;
    private bool _disposed;
    private string? _error;
    private List<JsonObject> _rows = [];
    private List<string> _columns = [];

    protected override async Task OnInitializedAsync()
    {
        Demo.Changed += OnChanged;
        await SelectAsync(_selected);
    }

    private void OnChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            if (!_loading && (_loadedMode != Demo.Mode || _loadedUserId != Demo.UserId))
            {
                var load = SelectAsync(_selected);
                StateHasChanged();
                await load;
            }
            if (!_disposed) StateHasChanged();
        });
    }

    private async Task SelectAsync(string system)
    {
        _selected = system;
        _loadedMode = Demo.Mode;
        _loadedUserId = Demo.UserId;
        _loading = true;
        _error = null;
        _rows = [];
        using var operation = Demo.BeginOperation();
        try
        {
            _rows = await Api.GetSystemAsync(system, _loadedMode, _loadedUserId, _lifetime.Token);
            _columns = _rows.SelectMany(row => row.Select(field => field.Key)).Distinct().ToList();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException or InvalidOperationException or OperationCanceledException)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string? RowClass(JsonObject row) =>
        Display(row["actorType"]) == "Agent" ? "audit-agent-row"
        : Display(row["status"]) == "Never touched by agent" ? "usage-untouched-row" : null;
    private static string Display(JsonNode? value) =>
        value is JsonValue scalar && scalar.TryGetValue<string>(out var text) ? text : value?.ToJsonString() ?? "—";
    private static bool IsEmailAddress(string value) =>
        System.Net.Mail.MailAddress.TryCreate(value, out var address)
        && string.Equals(address.Address, value, StringComparison.Ordinal);
    private static string Json(object value) =>
        System.Text.Json.JsonSerializer.Serialize(value, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
    private static string Title(JsonObject row) =>
        Display(row["customerName"] ?? row["title"] ?? row["name"] ?? row["customerId"] ?? row["id"]);

    public void Dispose()
    {
        _disposed = true;
        Demo.Changed -= OnChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
